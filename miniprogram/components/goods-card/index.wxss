:host {
  display: block;
  width: 100%;
}

.gcard {
  display: flex;
  flex-direction: column;
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(150, 100, 60, 0.08);
}

/* ---------- 图片位 ---------- */
.gcard-media {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%; /* 1:1 正方形 */
  background: #fbf3e8;
}

.gcard-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.gcard-ph {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fbeee1 0%, #f4e1cc 100%);
  border: 2rpx dashed rgba(194, 90, 46, 0.28);
  color: #c0a88f;
}

.gcard-ph-txt {
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.gcard-ph-hint {
  font-size: 18rpx;
  color: #cdb8a0;
  margin-top: 4rpx;
}

.gcard-badge {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #d2703f, #c25a2e);
  color: #fff;
  font-size: 20rpx;
  line-height: 36rpx;
}

/* ---------- 文字信息 ---------- */
.gcard-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 18rpx 20rpx 20rpx;
}

.gcard-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3a2a20;
  line-height: 1.35;
  height: 76rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.gcard-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.gcard-spec {
  font-size: 22rpx;
  color: #b6a797;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  flex: 1;
}

.gcard-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.gcard-price {
  display: flex;
  align-items: baseline;
  color: #c25a2e;
  font-weight: 600;
}

.gcard-cur {
  font-size: 22rpx;
  margin-right: 2rpx;
}

.gcard-num {
  font-size: 36rpx;
}

.gcard-unit {
  font-size: 20rpx;
  color: #b6a797;
  font-weight: 400;
  margin-left: 4rpx;
}

.gcard-add {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #d2703f, #c25a2e);
  color: #fff;
  font-size: 36rpx;
  line-height: 52rpx;
  text-align: center;
  box-shadow: 0 6rpx 14rpx rgba(194, 90, 46, 0.3);
}

.gcard-add--hover {
  transform: scale(0.92);
}

/* ---------- 横向列表排版 ---------- */
.gcard.is-row {
  flex-direction: row;
  align-items: stretch;
  padding: 16rpx;
}

.gcard.is-row .gcard-media {
  width: 176rpx;
  height: 176rpx;
  padding-bottom: 0;
  flex: none;
  border-radius: 16rpx;
  overflow: hidden;
}

.gcard.is-row .gcard-info {
  padding: 4rpx 0 4rpx 20rpx;
  justify-content: space-between;
}

.gcard.is-row .gcard-name {
  height: auto;
  max-height: 76rpx;
}
