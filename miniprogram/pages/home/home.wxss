/* pages/home/home.wxss */

/* 整页交给 scroll-view，才能换成「小猫版」下拉刷新 */
.home-scroll {
  height: 100vh;
}

/* 下拉刷新时小猫待的那一小条 */
.cat-refresher {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.home {
  padding-bottom: 20rpx;
}

/* ===== 品牌头部 ===== */
.hero {
  position: relative;
  padding: 28rpx 32rpx 100rpx;
  background: linear-gradient(160deg, #fff6ec 0%, #fbe4cd 55%, #f4d6b6 100%);
  border-bottom-left-radius: 44rpx;
  border-bottom-right-radius: 44rpx;
  overflow: hidden;
}

/* 若有若无的两个暖色圆形，增加手工感 */
.hero::before {
  content: "";
  position: absolute;
  right: -80rpx;
  top: -110rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
}

.hero::after {
  content: "";
  position: absolute;
  left: -70rpx;
  bottom: 30rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(223, 163, 71, 0.14);
}

.hero-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.hero-logo {
  min-width: 92rpx;
  height: 92rpx;
  padding: 0 20rpx;
  flex: none;
  border-radius: 26rpx;
  background: linear-gradient(140deg, #d2703f, #a84a22);
  color: #fff8f0;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 20rpx rgba(168, 74, 34, 0.28);
}

.hero-txt {
  margin-left: 20rpx;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-slogan {
  font-size: 24rpx;
  color: #a3765a;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.hero-search {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
}

.hero-tips {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.hero-tip {
  font-size: 21rpx;
  color: #b06a3c;
  background: rgba(255, 255, 255, 0.66);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  margin: 8rpx 12rpx 0 0;
}

/* ===== 轮播图 ===== */
.banner-wrap {
  position: relative;
  z-index: 2;
  padding: 0 24rpx;
  margin-top: -72rpx;
}

.banner {
  height: 320rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 14rpx 30rpx rgba(150, 100, 60, 0.16);
}

.banner-item {
  width: 100%;
  height: 100%;
}

.banner-img {
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
}

.banner-ph {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f6e0c6, #edc79e);
  border: 2rpx dashed rgba(194, 90, 46, 0.3);
  border-radius: 28rpx;
}

.banner-ph-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #a9662f;
  letter-spacing: 2rpx;
}

.banner-ph-sub {
  font-size: 24rpx;
  color: #b3814f;
  margin-top: 10rpx;
}

.banner-ph-hint {
  font-size: 20rpx;
  color: #c39a70;
  margin-top: 20rpx;
}

/* ===== 分类金刚区 ===== */
.nav-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 28rpx 24rpx 0;
  padding: 28rpx 8rpx 4rpx;
}

.nav-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.nav-ico {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(140deg, #fdf2e5, #f6e2cd);
  border: 2rpx dashed rgba(194, 90, 46, 0.22);
  overflow: hidden;
}

.nav-emoji {
  font-size: 40rpx;
}

.nav-img {
  width: 100%;
  height: 100%;
}

.nav-name {
  font-size: 22rpx;
  color: var(--ink-2);
  margin-top: 12rpx;
}
