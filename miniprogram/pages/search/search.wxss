/* pages/search/search.wxss */
.search-page {
  padding-bottom: 40rpx;
}

.search-top {
  padding: 20rpx 24rpx 8rpx;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
  color: var(--ink);
}

.search-input-ph {
  color: var(--ink-3);
  font-size: 26rpx;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  border-radius: 50%;
  background: #f0e2d3;
  color: #a08e7d;
  font-size: 22rpx;
  text-align: center;
  line-height: 44rpx;
}

/* ===== 区块 ===== */
.s-block {
  padding: 32rpx 24rpx 0;
}

.s-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.s-title {
  font-size: 30rpx;
  font-weight: 600;
}

.s-action {
  font-size: 24rpx;
  color: var(--ink-3);
}

.s-hint {
  font-size: 22rpx;
  color: var(--ink-3);
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  font-size: 25rpx;
  color: var(--ink-2);
  background: #fff;
  border-radius: 32rpx;
  padding: 12rpx 28rpx;
  margin: 0 16rpx 18rpx 0;
  box-shadow: 0 6rpx 14rpx rgba(150, 100, 60, 0.07);
}

.chip-hot {
  color: var(--brand);
  background: #fdf1e6;
}

.s-tip {
  margin: 20rpx 24rpx 0;
  padding: 28rpx 30rpx;
  border-radius: var(--r);
  background: linear-gradient(135deg, #fdf2e5, #f7e3cd);
  border: 2rpx dashed rgba(194, 90, 46, 0.25);
}

.s-tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #a9662f;
}

.s-tip-desc {
  font-size: 24rpx;
  color: #b3814f;
  margin-top: 10rpx;
}

/* ===== 结果 ===== */
.s-result-head {
  display: flex;
  align-items: baseline;
  padding: 28rpx 24rpx 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.s-result-count {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-3);
  margin-left: 16rpx;
}

.empty-btn {
  margin-top: 40rpx;
  width: 320rpx;
}
